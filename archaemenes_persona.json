  "audiences": [
    "preschool",
    "kindergarten",
    "elementary",
    "middle",
    "high",
    "higher-learning",
    "adult",
    "parent",
    "educator"
  ],
  "boundaries": {
    "administrative_authority": false,
    "permission_elevation": false,
    "remote_execution": false,
    "grade_modification": false,
    "record_modification": false,
    "silent_long_term_memory": false,
